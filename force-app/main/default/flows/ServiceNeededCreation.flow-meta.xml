        <connector>
            <targetReference>Create_Service_Needed_Records</targetReference>
        </connector>
    </assignments>
    <description>Create Service Needed Record</description>
    <environments>Default</environments>
    <formulas>
        <name>fm_MonthlyGallonsAssignment</name>
        <dataType>Number</dataType>
        <expression>IF(
  TEXT( {!$Record.Service_Type__c})= &quot;UCO&quot;,
    VALUE(TEXT({!$Record.Lead__r.UCO_Gal_Month__c})), 
    NULL
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fx_DynamicFrequency</name>
        <dataType>Number</dataType>
        <expression>CASE(TEXT({!$Record.Service_Type__c}),
    &quot;IGT&quot;, {!$Record.IGT_Frequency_Days__c},
    &quot;EGT&quot;, {!$Record.EGT_Frequency_Days__c},
    &quot;HYD&quot;, {!$Record.HYD_Frequency_Days__c},
    NULL
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fx_DynamicRate</name>
        <dataType>Currency</dataType>
        <expression>CASE(TEXT({!$Record.Service_Type__c}),
    &quot;IGT&quot;, {!$Record.IGT_Rate__c},
    &quot;EGT&quot;, {!$Record.EGT_Rate__c},
    &quot;HYD&quot;, {!$Record.HYD_Rate__c},
    NULL
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fx_DynamicSkill</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!$Record.Service_Type__c}),
    &quot;UCO&quot;, &quot;UCO&quot;,
    &quot;IGT&quot;, &quot;GT&quot;,
    &quot;EGT&quot;, &quot;INT&quot;,
    &quot;HYD&quot;, &quot;HYD&quot;,
    NULL
)</expression>
    </formulas>
    <formulas>
        <name>serviceNeededOrderType</name>
        <dataType>String</dataType>
        <expression>CASE( TEXT({!$Record.Service_Type__c}), 
  &quot;UCO&quot;, &quot;T&quot;, 
  &quot;IGT&quot;, &quot;T&quot;, 
  &quot;EGT&quot;, &quot;T&quot;, 
  &quot;HYD&quot;, &quot;P&quot;, 
  &quot;WR&quot;, &quot;D&quot;, 
  NULL 
)</expression>
    </formulas>
    <formulas>
        <name>serviceNeededRecordType</name>
        <dataType>String</dataType>
        <expression>CASE( TEXT({!$Record.Service_Type__c}), 
  &quot;UCO&quot;, &quot;Used_Cooking_Oil&quot;, 
  &quot;EGT&quot;, &quot;Interceptor&quot;, 
  &quot;IGT&quot;, &quot;Grease_Trap&quot;, 
  &quot;HYD&quot;, &quot;Drain_Cleaning&quot;, 
  &quot;WR&quot;, &quot;Waste_Run&quot;, 
  NULL 
)</expression>
    </formulas>
    <interviewLabel>ServiceNeededCreation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ServiceNeededCreation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
