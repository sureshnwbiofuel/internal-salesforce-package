<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>Assign_Service_Needed</name>
        <label>Assign Service Needed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>createServiceNeeded.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_RecordTypeId.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createServiceNeeded.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createServiceNeeded.Order_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>serviceNeededOrderType</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createServiceNeeded.Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createServiceNeeded.Opportunity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createServiceNeeded.Monthly_Gallons__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fm_MonthlyGallonsAssignment</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createServiceNeeded.Rate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_DynamicRate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createServiceNeeded.Frequency_Days__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_DynamicFrequency</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createServiceNeeded.Skills__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_DynamicSkill</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createServiceNeeded.Communication_Preference__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Account.Notification_Preference__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createServiceNeeded.Notification_Email__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Account.Notification_Email__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createServiceNeeded.Notification_Phone_Number__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Account.Notification_Phone_Number__c</elementReference>
            </value>
