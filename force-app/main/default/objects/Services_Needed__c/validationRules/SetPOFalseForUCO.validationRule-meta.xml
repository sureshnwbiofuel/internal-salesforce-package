<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SetPOFalseForUCO</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;UCO&quot;,
    Has_PO__c = TRUE
)</errorConditionFormula>
    <errorDisplayField>Has_PO__c</errorDisplayField>
    <errorMessage>Has PO must be unchecked for UCO Service Needed records.</errorMessage>
</ValidationRule>
